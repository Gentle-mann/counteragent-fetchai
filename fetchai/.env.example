ASI1_API_KEY=
ASI1_MODEL=asi1
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
COUNTERAGENT_SEED=
# False for local smoke tests; true when connecting the buyer to Agentverse.
COUNTERAGENT_MAILBOX=true
# Public /submit endpoint when using Agentverse v2 external integration.
COUNTERAGENT_ENDPOINT=
# Optional public background research (adds latency; never vendor evidence).
COUNTERAGENT_WEB_RESEARCH=false
# demo (default), or stripe_test with a test-only key. Live keys are rejected.
COUNTERAGENT_PAYMENT_BACKEND=demo
STRIPE_SECRET_KEY=

# Optional independent public advisers (extra latency)
COUNTERAGENT_EXTERNAL_ADVISERS=0
# Optional private Slack approval bridge; obtain your own tokens.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
SLACK_APPROVER_IDS=
